# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only for the reminders cron job (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ИИ-коуч (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Вечерние напоминания по email (resend.com -> API Keys). Без него cron просто
# ничего не отправляет, деплой не ломается.
RESEND_API_KEY=your-resend-api-key
REMINDER_FROM_EMAIL=AI Food Coach <onboarding@resend.dev>

# Секрет, которым Vercel Cron подписывает вызовы /api/cron/* (любая случайная строка)
CRON_SECRET=your-random-secret

# Публичный адрес сайта — используется в тексте писем-напоминаний
NEXT_PUBLIC_APP_URL=https://food-coach-web.vercel.app
