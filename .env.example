# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only for the reminders cron job (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ИИ-коуч (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Вечерние напоминания по SMS (twilio.com -> Console -> Account Info + номер).
# Если указаны и у пользователя заполнен телефон в "Напоминаниях" — используется SMS,
# иначе напоминание уходит на email через RESEND_API_KEY ниже.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Вечерние напоминания по email (resend.com -> API Keys), запасной канал.
# Без RESEND_API_KEY и без TWILIO_* cron просто ничего не отправляет, деплой не ломается.
RESEND_API_KEY=your-resend-api-key
REMINDER_FROM_EMAIL=AI Food Coach <onboarding@resend.dev>

# Секрет, которым Vercel Cron подписывает вызовы /api/cron/* (любая случайная строка)
CRON_SECRET=your-random-secret

# Публичный адрес сайта — используется в тексте писем-напоминаний
NEXT_PUBLIC_APP_URL=https://food-coach-web.vercel.app

# Email-адреса (через запятую), которым доступна /admin — список клиентов и их активность.
# Ссылка "Админ-панель" на экране Профиль показывается только этим адресам.
ADMIN_EMAILS=you@example.com
